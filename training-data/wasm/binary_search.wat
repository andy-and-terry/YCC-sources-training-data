(module
  (func $binary_search (export "binary_search")
        (param $base i32) (param $len i32) (param $target i32) (result i32)
    (local $low i32)
    (local $high i32)
    (local $mid i32)
    (local $value i32)
    (local.set $low (i32.const 0))
    (local.set $high (i32.sub (local.get $len) (i32.const 1)))
    (block $done (result i32)
      (loop $search
        (if (i32.gt_s (local.get $low) (local.get $high))
          (then (br $done (i32.const -1))))
        (local.set $mid (i32.div_s (i32.add (local.get $low) (local.get $high)) (i32.const 2)))
        (local.set $value (i32.load (i32.add (local.get $base) (i32.mul (local.get $mid) (i32.const 4)))))
        (if (i32.eq (local.get $value) (local.get $target))
          (then (br $done (local.get $mid))))
        (if (i32.lt_s (local.get $value) (local.get $target))
          (then (local.set $low (i32.add (local.get $mid) (i32.const 1))))
          (else (local.set $high (i32.sub (local.get $mid) (i32.const 1)))))
        (br $search))
      (unreachable)))
)
