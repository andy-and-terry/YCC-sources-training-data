(module
  (memory (export "memory") 1)

  (func $ext_gcd (export "ext_gcd") (param $a i32) (param $b i32) (param $out_base i32) (result i32)
    (local $old_r i32)
    (local $r i32)
    (local $old_s i32)
    (local $s i32)
    (local $old_t i32)
    (local $t i32)
    (local $quotient i32)
    (local $tmp i32)
    (local.set $old_r (local.get $a))
    (local.set $r (local.get $b))
    (local.set $old_s (i32.const 1))
    (local.set $s (i32.const 0))
    (local.set $old_t (i32.const 0))
    (local.set $t (i32.const 1))
    (block $done
      (loop $loop
        (br_if $done (i32.eqz (local.get $r)))
        (local.set $quotient (i32.div_s (local.get $old_r) (local.get $r)))
        (local.set $tmp (i32.sub (local.get $old_r) (i32.mul (local.get $quotient) (local.get $r))))
        (local.set $old_r (local.get $r))
        (local.set $r (local.get $tmp))
        (local.set $tmp (i32.sub (local.get $old_s) (i32.mul (local.get $quotient) (local.get $s))))
        (local.set $old_s (local.get $s))
        (local.set $s (local.get $tmp))
        (local.set $tmp (i32.sub (local.get $old_t) (i32.mul (local.get $quotient) (local.get $t))))
        (local.set $old_t (local.get $t))
        (local.set $t (local.get $tmp))
        (br $loop)))
    (i32.store (local.get $out_base) (local.get $old_s))
    (i32.store (i32.add (local.get $out_base) (i32.const 4)) (local.get $old_t))
    (local.get $old_r))
)
