(module
  (memory (export "memory") 1)

  (func $mod_inverse (export "mod_inverse") (param $a i32) (param $m i32) (result i32)
    (local $old_r i32)
    (local $r i32)
    (local $old_s i32)
    (local $s i32)
    (local $quotient i32)
    (local $tmp i32)
    (local.set $old_r (local.get $a))
    (local.set $r (local.get $m))
    (local.set $old_s (i32.const 1))
    (local.set $s (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.eqz (local.get $r)))
        (local.set $quotient (i32.div_s (local.get $old_r) (local.get $r)))
        (local.set $tmp (i32.sub (local.get $old_r) (i32.mul (local.get $quotient) (local.get $r))))
        (local.set $old_r (local.get $r))
        (local.set $r (local.get $tmp))
        (local.set $tmp (i32.sub (local.get $old_s) (i32.mul (local.get $quotient) (local.get $s))))
        (local.set $old_s (local.get $s))
        (local.set $s (local.get $tmp))
        (br $loop)))
    (i32.rem_s (i32.add (i32.rem_s (local.get $old_s) (local.get $m)) (local.get $m)) (local.get $m)))

  (func $crt_combine (export "crt_combine") (param $r1 i32) (param $m1 i32) (param $r2 i32) (param $m2 i32) (result i32)
    (local $inv i32)
    (local $diff i32)
    (local $k i32)
    (local $lcm i32)
    (local $x i32)
    (local.set $inv (call $mod_inverse (local.get $m1) (local.get $m2)))
    (local.set $diff (i32.rem_s (i32.add (i32.rem_s (i32.sub (local.get $r2) (local.get $r1)) (local.get $m2)) (local.get $m2)) (local.get $m2)))
    (local.set $k (i32.rem_s (i32.mul (local.get $diff) (local.get $inv)) (local.get $m2)))
    (local.set $lcm (i32.mul (local.get $m1) (local.get $m2)))
    (local.set $x (i32.add (local.get $r1) (i32.mul (local.get $m1) (local.get $k))))
    (i32.rem_s (i32.add (i32.rem_s (local.get $x) (local.get $lcm)) (local.get $lcm)) (local.get $lcm)))
)
