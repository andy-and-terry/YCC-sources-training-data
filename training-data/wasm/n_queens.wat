(module
  (memory (export "memory") 1)

  (func $is_safe (export "is_safe") (param $queens_base i32) (param $count i32) (param $col i32) (result i32)
    (local $i i32)
    (local $q i32)
    (local $dist i32)
    (local.set $i (i32.const 0))
    (block $unsafe (result i32)
      (loop $loop (result i32)
        (if (result i32) (i32.ge_s (local.get $i) (local.get $count))
          (then (i32.const 1))
          (else
            (local.set $q (i32.load (i32.add (local.get $queens_base) (i32.mul (local.get $i) (i32.const 4)))))
            (local.set $dist (i32.sub (local.get $count) (local.get $i)))
            (if (i32.eq (local.get $q) (local.get $col))
              (then (br $unsafe (i32.const 0))))
            (if (i32.eq (i32.sub (local.get $q) (local.get $col)) (local.get $dist))
              (then (br $unsafe (i32.const 0))))
            (if (i32.eq (i32.sub (local.get $col) (local.get $q)) (local.get $dist))
              (then (br $unsafe (i32.const 0))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $loop))))))

  (func $count_safe_placements (export "count_safe_placements") (param $queens_base i32) (param $count i32) (param $n i32) (result i32)
    (local $col i32)
    (local $safe i32)
    (local $result i32)
    (local $i i32)
    (local $q i32)
    (local $dist i32)
    (local.set $result (i32.const 0))
    (local.set $col (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_s (local.get $col) (local.get $n)))
        (local.set $safe (i32.const 1))
        (local.set $i (i32.const 0))
        (block $inner_done
          (loop $inner
            (br_if $inner_done (i32.ge_s (local.get $i) (local.get $count)))
            (local.set $q (i32.load (i32.add (local.get $queens_base) (i32.mul (local.get $i) (i32.const 4)))))
            (local.set $dist (i32.sub (local.get $count) (local.get $i)))
            (if (i32.or
                  (i32.eq (local.get $q) (local.get $col))
                  (i32.eq (i32.sub (local.get $q) (local.get $col))
                    (select (local.get $dist) (i32.sub (i32.const 0) (local.get $dist)) (i32.ge_s (local.get $q) (local.get $col)))))
              (then (local.set $safe (i32.const 0))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $inner)))
        (if (local.get $safe) (then (local.set $result (i32.add (local.get $result) (i32.const 1)))))
        (local.set $col (i32.add (local.get $col) (i32.const 1)))
        (br $loop)))
    (local.get $result))
)
