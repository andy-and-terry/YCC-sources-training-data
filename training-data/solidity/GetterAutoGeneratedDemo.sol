pragma solidity ^0.8.20;

// `public` state variables get an automatic getter; mappings and arrays take
// the key or index as an argument, and structs return a tuple of their members.
contract GetterAutoGeneratedDemo {
    struct Profile {
        string name;
        uint256 score;
        uint256[] history; // arrays inside structs are omitted from the getter
    }

    uint256 public total = 42;
    string public label = "demo";
    uint256[] public values;
    mapping(address => uint256) public balances;
    mapping(address => mapping(uint256 => bool)) public flags;
    mapping(uint256 => Profile) public profiles;

    constructor() {
        values.push(10);
        values.push(20);
        balances[msg.sender] = 5;
        flags[msg.sender][1] = true;
        profiles[1].name = "ada";
        profiles[1].score = 99;
    }

    function readProfile() external view returns (string memory name, uint256 score) {
        // Same shape as the generated getter profiles(1)
        return this.profiles(1);
    }

    function viaGetters() external view returns (uint256, uint256, bool) {
        return (this.values(1), this.balances(msg.sender), this.flags(msg.sender, 1));
    }
}
