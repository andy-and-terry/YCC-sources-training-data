(* Real arithmetic and the Math structure *)
val () = print (Real.toString (Math.sqrt 2.0) ^ "\n")
val () = print (Real.fmt (StringCvt.FIX (SOME 3)) Math.pi ^ "\n")
val () = print (Int.toString (Real.floor 3.7) ^ "\n")
val () = print (Int.toString (Real.ceil 3.2) ^ "\n")
val () = print (Int.toString (Real.round 2.6) ^ "\n")
val () = print (Int.toString (Real.trunc ~2.7) ^ "\n")
val () = print (Real.toString (Math.pow (2.0, 10.0)) ^ "\n")
val () = print (Real.toString (Real.fromInt 7 / 2.0) ^ "\n")
val () = print (Bool.toString (Real.== (0.5, 1.0 / 2.0)) ^ "\n")
