Sub Main()
    Debug.Print "Round(2.5) = " & Round(2.5)
    Debug.Print "Round(3.5) = " & Round(3.5)
    Debug.Print "Round(2.675, 2) = " & Round(2.675, 2)
    Debug.Print "Int(-2.5) = " & Int(-2.5)
    Debug.Print "Fix(-2.5) = " & Fix(-2.5)
    Debug.Print "CInt(2.5) = " & CInt(2.5)
    Debug.Print "CLng(-0.5) = " & CLng(-0.5)
    Debug.Print "Ceiling(2.1) = " & -Int(-2.1)
    Debug.Print "Sgn(-9) = " & Sgn(-9)
    Debug.Print "Abs(-9.5) = " & Abs(-9.5)
    Debug.Print "7 Mod 3 = " & (7 Mod 3) & ", -7 Mod 3 = " & (-7 Mod 3)
    Debug.Print "7 \ 2 = " & (7 \ 2)
End Sub
