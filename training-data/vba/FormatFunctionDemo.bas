Sub Main()
    Debug.Print Format$(1234.5678, "0.00")
    Debug.Print Format$(1234.5678, "#,##0.0")
    Debug.Print Format$(0.256, "0%")
    Debug.Print Format$(0.256, "0.0%")
    Debug.Print Format$(42, "00000")
    Debug.Print Format$(5, "0.00")
    Debug.Print Format$(-7.5, "0.0;(0.0)")
    Debug.Print Format$(1234567, "Standard")
    Debug.Print Format$(0.5, "Percent")
    Debug.Print Format$(1500, "Currency")
    Debug.Print Format$(123456789, "Scientific")
    Debug.Print Format$(1, "Yes/No"), Format$(0, "Yes/No")
    Debug.Print Format$(True, "True/False")

    Debug.Print Format$("hello", ">")
    Debug.Print Format$("HELLO", "<")
    Debug.Print Format$("abc", "@@@@@@")

    Dim d As Date
    d = DateSerial(2024, 7, 4) + TimeSerial(15, 30, 0)
    Debug.Print Format$(d, "yyyy-mm-dd hh:nn")
    Debug.Print Format$(d, "d mmm yy")
    Debug.Print Format$(d, "dddd")
    Debug.Print Format$(d, "h:nn AM/PM")
    Debug.Print Format$(d, "Long Date")
    Debug.Print Format$(d, "Short Time")

    Debug.Print FormatNumber(1234567.891, 2)
    Debug.Print FormatCurrency(-45.5)
    Debug.Print FormatPercent(0.0725, 1)
    Debug.Print FormatNumber(0.5, 2, vbTrue)
    Debug.Print Right$("0000" & CStr(42), 4)
End Sub
