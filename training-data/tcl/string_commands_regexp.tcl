set s "Hello, World"
puts [string length $s]
puts [string toupper $s]
puts [string range $s 7 end]
puts [string index $s 4]
puts [string first "o" $s]
puts [string last "o" $s]
puts [string map {l L o 0} $s]
puts [string match "H*d" $s]
puts [string trim "  pad  "]
puts [string repeat ab 3]
puts [string reverse $s]
puts [string is integer 42]
puts [string compare apple banana]
puts [string equal -nocase ABC abc]
puts [format "%05.1f|%-5s|%3d|%x" 3.14159 ab 7 255]
puts [scan "12 apples" "%d %s" n w]; puts "$n $w"
puts [regexp {(\d+)-(\d+)} "tel 555-1234" all a b]; puts "$all $a $b"
puts [regsub -all {\d} "a1b2" #]
puts [regexp -all -inline {\d+} "a1b22c333"]
puts [string cat a b c]
puts [string totitle "hello"]
puts [split "a b c" " "]
puts [string bytelength "héllo"]
puts [expr {[string length "héllo"]}]
