(let ((s "Hello, World"))
  (format t "~a ~a ~a~%" (length s) (string-upcase s) (string-downcase s))
  (format t "~a ~a~%" (subseq s 7) (search "World" s))
  (format t "~a ~a~%" (char s 0) (char-code (char s 0)))
  (format t "~a~%" (reverse s))
  (format t "~a~%" (string-trim " " "  pad  "))
  (format t "~a ~a~%" (string= "a" "a") (string< "a" "b"))
  (format t "~a~%" (concatenate 'string "a" "b" "c"))
  (format t "~a~%" (map 'string #'char-upcase "abc"))
  (format t "~a~%" (with-output-to-string (o) (write-string "x" o) (write-char #\y o)))
  (format t "~a ~a~%" (parse-integer "42") (princ-to-string 3.5))
  (format t "~a~%" (coerce "abc" 'list))
  (format t "~a ~a~%" (digit-char-p #\7) (alpha-char-p #\a)))
