(let ((v (make-array 5 :initial-element 0))
      (fv (make-array 0 :adjustable t :fill-pointer 0)))
  (dotimes (i 5)
    (setf (aref v i) (* i i)))
  (print v)
  (print (length v))
  (dolist (x '(a b c))
    (vector-push-extend x fv))
  (print fv)
  (print (vector-pop fv))
  (print (reverse v))
  (print (position 9 v))
  (print (subseq v 1 4))
  (print (map 'vector #'1+ v))
  (terpri))
