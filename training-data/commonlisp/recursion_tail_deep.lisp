(defun fact (n &optional (acc 1)) (if (<= n 1) acc (fact (1- n) (* acc n))))
(defun fib (n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(defun flatten (x) (cond ((null x) nil) ((atom x) (list x)) (t (append (flatten (car x)) (flatten (cdr x))))))
(defun hanoi (n from to via) (if (zerop n) 0 (+ (hanoi (1- n) from via to) 1 (hanoi (1- n) via to from))))
(defun ackermann (m n) (cond ((zerop m) (1+ n)) ((zerop n) (ackermann (1- m) 1)) (t (ackermann (1- m) (ackermann m (1- n))))))
(format t "~a ~a ~a~%" (fact 20) (fib 20) (flatten '(1 (2 (3 4)) 5)))
(format t "~a ~a~%" (hanoi 10 'a 'c 'b) (ackermann 2 3))
(defun permutations (l) (if (null l) '(()) (mapcan (lambda (x) (mapcar (lambda (p) (cons x p)) (permutations (remove x l :count 1)))) l)))
(format t "~a~%" (permutations '(1 2 3)))
