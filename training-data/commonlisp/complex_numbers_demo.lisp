(let ((z (complex 3 4))
      (w #c(1 -2)))
  (format t "z=~a w=~a~%" z w)
  (format t "sum ~a product ~a~%" (+ z w) (* z w))
  (format t "abs ~a~%" (abs z))
  (format t "conj ~a~%" (conjugate z))
  (format t "real ~a imag ~a~%" (realpart z) (imagpart z))
  (format t "sqrt(-4) = ~a~%" (sqrt -4))
  (format t "phase ~,4f~%" (phase #c(0 1))))
