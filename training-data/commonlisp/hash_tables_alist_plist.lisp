(let ((h (make-hash-table :test 'equal)))
  (setf (gethash "a" h) 1 (gethash "b" h) 2)
  (incf (gethash "a" h))
  (multiple-value-bind (v found) (gethash "z" h) (format t "~a ~a~%" v found))
  (format t "~a ~a~%" (gethash "a" h) (hash-table-count h))
  (maphash (lambda (k v) (format t "~a=~a " k v)) h) (terpri)
  (remhash "a" h)
  (format t "~a~%" (loop for k being the hash-keys of h collect k)))
(let ((al '((a . 1) (b . 2))))
  (format t "~a ~a~%" (cdr (assoc 'b al)) (rassoc 1 al)))
(let ((pl '(:x 1 :y 2)))
  (format t "~a ~a~%" (getf pl :y) (getf pl :z 'none)))
