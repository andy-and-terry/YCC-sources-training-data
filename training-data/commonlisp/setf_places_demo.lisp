(let ((lst (list 1 2 3))
      (v (vector 10 20 30))
      (h (make-hash-table)))
  (setf (first lst) 100)
  (setf (nth 2 lst) 300)
  (setf (aref v 1) 99)
  (setf (gethash :k h) 'value)
  (incf (aref v 0) 5)
  (push 0 lst)
  (print lst)
  (print v)
  (print (gethash :k h))
  (rotatef (aref v 0) (aref v 2))
  (print v)
  (psetf (aref v 0) (aref v 1) (aref v 1) (aref v 0))
  (print v))
(terpri)
