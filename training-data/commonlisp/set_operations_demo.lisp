(let ((a '(1 2 3 4))
      (b '(3 4 5 6)))
  (format t "union: ~a~%" (sort (union a b) #'<))
  (format t "intersection: ~a~%" (sort (intersection a b) #'<))
  (format t "difference: ~a~%" (sort (set-difference a b) #'<))
  (format t "symmetric: ~a~%" (sort (set-exclusive-or a b) #'<))
  (format t "subset: ~a~%" (subsetp '(1 2) a))
  (format t "member: ~a~%" (member 3 a))
  (format t "adjoin: ~a~%" (adjoin 9 a))
  (format t "remove-duplicates: ~a~%" (remove-duplicates '(1 2 1 3 2 4))))
