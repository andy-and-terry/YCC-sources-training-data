(format t "~a ~a ~a ~a~%" (eq '(1) '(1)) (eql 1.0 1.0) (equal '(1 (2)) '(1 (2))) (equalp "AbC" "aBc"))
(format t "~a ~a~%" (eql 2 2.0) (= 2 2.0))
(let* ((a (list 1 2 3)) (b a) (c (copy-list a)))
  (setf (car b) 99)
  (format t "~a ~a ~a~%" a c (eq a b)))
(let ((l (list 1 2 3)))
  (push 0 l) (pop l) (incf (second l) 10) (rplacd (last l) '(4))
  (format t "~a~%" l))
(format t "~a ~a~%" (type-of 1) (type-of "s"))
(format t "~a ~a ~a~%" (typep 1 'integer) (typep 1.5 'float) (subtypep 'integer 'number))
(format t "~a ~a~%" (floor -7 2) (ceiling 7 2))
(format t "~a ~a ~a~%" (gcd 12 18) (lcm 4 6) (expt 2 100))
(format t "~a ~a~%" (random 1) (isqrt 50))
(format t "~a~%" (coerce 3 'double-float))
