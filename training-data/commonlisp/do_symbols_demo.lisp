(defpackage :tiny (:use :cl) (:export #:alpha #:beta))
(in-package :tiny)
(defun alpha () 1)
(defun beta () 2)
(defun hidden () 3)

(in-package :cl-user)
(let (exported internal)
  (do-symbols (s :tiny)
    (when (eq (symbol-package s) (find-package :tiny))
      (multiple-value-bind (sym status) (find-symbol (symbol-name s) :tiny)
        (declare (ignore sym))
        (if (eq status :external) (push (symbol-name s) exported)
            (push (symbol-name s) internal)))))
  (format t "exported ~a~%" (sort exported #'string<))
  (format t "internal ~a~%" (sort internal #'string<)))
