(let* ((a (coerce '(5 3 8 1 9 2 7 4 6 0 3 5) 'vector))
       (bs 4)
       (blk (make-array 3 :initial-element 0)))
  (dotimes (i (length a))
    (incf (aref blk (floor i bs)) (aref a i)))
  (let ((sum 0) (i 2) (r 9))
    (loop while (<= i r)
          do (if (and (zerop (mod i bs)) (<= (+ i bs -1) r))
                 (progn (incf sum (aref blk (floor i bs))) (incf i bs))
                 (progn (incf sum (aref a i)) (incf i))))
    (print sum)))
