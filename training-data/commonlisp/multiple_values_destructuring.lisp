(defun div-mod (a b) (values (floor a b) (mod a b)))
(multiple-value-bind (q r) (div-mod 17 5) (format t "~a ~a~%" q r))
(format t "~a~%" (multiple-value-list (floor 7 2)))
(destructuring-bind (a (b c) &rest d &key e) '(1 (2 3) :e 4) (format t "~a ~a ~a ~a ~a~%" a b c d e))
(destructuring-bind (x &optional (y 10)) '(1) (format t "~a ~a~%" x y))
(multiple-value-call (lambda (&rest xs) (format t "~a~%" xs)) (values 1 2) (values 3))
(format t "~a~%" (nth-value 1 (truncate 7.5)))
(let (a b) (setf (values a b) (values 1 2)) (format t "~a~%" (+ a b)))
(defun f (&key (x 1) (y x)) (list x y))
(format t "~a ~a~%" (f) (f :x 5))
