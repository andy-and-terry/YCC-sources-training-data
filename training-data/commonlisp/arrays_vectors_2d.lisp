(let ((v (make-array 5 :initial-element 0))
      (m (make-array '(2 3) :initial-element 1))
      (a (make-array 0 :adjustable t :fill-pointer t)))
  (dotimes (i 5) (setf (aref v i) (* i i)))
  (setf (aref m 1 2) 9)
  (vector-push-extend 'x a) (vector-push-extend 'y a)
  (format t "~a ~a ~a~%" v m a)
  (format t "~a ~a~%" (array-dimensions m) (array-total-size m))
  (format t "~a~%" (reduce #'+ v))
  (format t "~a~%" (map 'vector #'1+ v))
  (format t "~a~%" (sort (vector 3 1 2) #'<))
  (format t "~a ~a~%" (position 9 m) (subseq v 1 3))
  (format t "~a~%" (coerce v 'list)))
