(defun edit-distance (a b)
  (let* ((m (length a))
         (n (length b))
         (dp (make-array (list (1+ m) (1+ n)) :initial-element 0)))
    (dotimes (i (1+ m)) (setf (aref dp i 0) i))
    (dotimes (j (1+ n)) (setf (aref dp 0 j) j))
    (dotimes (i m)
      (dotimes (j n)
        (setf (aref dp (1+ i) (1+ j))
              (if (char= (char a i) (char b j))
                  (aref dp i j)
                  (1+ (min (aref dp i j)
                           (aref dp i (1+ j))
                           (aref dp (1+ i) j)))))))
    (aref dp m n)))

(format t "edit distance 'kitten' -> 'sitting': ~a~%" (edit-distance "kitten" "sitting"))
(format t "edit distance 'flaw' -> 'lawn': ~a~%" (edit-distance "flaw" "lawn"))
