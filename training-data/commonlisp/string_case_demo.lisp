(defun title-case (string)
  (let ((result (string-downcase string))
        (start-of-word t))
    (dotimes (i (length result) result)
      (let ((c (char result i)))
        (when (and start-of-word (alpha-char-p c))
          (setf (char result i) (char-upcase c)))
        (setf start-of-word (not (alpha-char-p c)))))))

(format t "~a~%" (string-upcase "hello world"))
(format t "~a~%" (string-capitalize "hello wORLD"))
(format t "~a~%" (title-case "the QUICK brown fox"))
(format t "~a~%" (string-equal "LISP" "lisp"))
(format t "~a~%" (string-upcase "hello world" :start 6))
