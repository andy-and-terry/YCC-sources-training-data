(defparameter *n* 8)
(defparameter *graph* (make-array *n* :initial-element nil))
(defparameter *disc* (make-array *n* :initial-element -1))
(defparameter *low* (make-array *n* :initial-element -1))
(defparameter *on-stack* (make-array *n* :initial-element nil))
(defparameter *stack* nil)
(defparameter *index-counter* 0)
(defparameter *sccs* nil)

(defun tarjan-dfs (u)
  (setf (aref *disc* u) *index-counter*)
  (setf (aref *low* u) *index-counter*)
  (incf *index-counter*)
  (push u *stack*)
  (setf (aref *on-stack* u) t)
  (dolist (v (aref *graph* u))
    (cond
      ((= -1 (aref *disc* v))
       (tarjan-dfs v)
       (setf (aref *low* u) (min (aref *low* u) (aref *low* v))))
      ((aref *on-stack* v)
       (setf (aref *low* u) (min (aref *low* u) (aref *disc* v))))))
  (when (= (aref *disc* u) (aref *low* u))
    (let ((component nil))
      (loop
        (let ((w (pop *stack*)))
          (setf (aref *on-stack* w) nil)
          (push w component)
          (when (= w u) (return))))
      (push (nreverse component) *sccs*))))

(defun tarjan-scc ()
  (dotimes (i *n*)
    (when (= -1 (aref *disc* i))
      (tarjan-dfs i)))
  (nreverse *sccs*))

(setf (aref *graph* 0) '(1))
(setf (aref *graph* 1) '(2))
(setf (aref *graph* 2) '(0 3))
(setf (aref *graph* 3) '(4))
(setf (aref *graph* 4) '(3))
(setf (aref *graph* 5) '(6))
(setf (aref *graph* 6) '(7))
(setf (aref *graph* 7) nil)

(print (tarjan-scc))
