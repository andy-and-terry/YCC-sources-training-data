(let ((nums '(4 8 15 16 23 42))
      (word "mississippi"))
  (format t "find 15: ~a~%" (find 15 nums))
  (format t "position of 23: ~a~%" (position 23 nums))
  (format t "find-if >10: ~a~%" (find-if (lambda (x) (> x 10)) nums))
  (format t "last odd position: ~a~%" (position-if #'oddp nums :from-end t))
  (format t "count #\\s: ~a~%" (count #\s word))
  (format t "search 'ssi': ~a~%" (search "ssi" word))
  (format t "search from 3: ~a~%" (search "ssi" word :start2 3))
  (format t "mismatch: ~a~%" (mismatch "banana" "bandana"))
  (format t "every evenp: ~a~%" (every #'evenp nums))
  (format t "some >40: ~a~%" (some (lambda (x) (> x 40)) nums)))
