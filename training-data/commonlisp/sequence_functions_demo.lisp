(defparameter *xs* '(3 1 4 1 5 9 2 6))

(print (remove-if #'evenp *xs*))
(print (remove-duplicates *xs*))
(print (find 4 *xs*))
(print (position 5 *xs*))
(print (count 1 *xs*))
(print (subseq *xs* 2 5))
(print (find-if (lambda (x) (> x 4)) *xs*))
(print (some #'zerop *xs*))
(print (every #'plusp *xs*))
(print (substitute 0 1 *xs*))
(print (reverse "abc"))
(print (concatenate 'string "foo" "bar"))
(terpri)
