(let ((plist (list :name "Ada" :age 36)))
  (format t "~a~%" (getf plist :name))
  (format t "~a~%" (getf plist :email "none"))
  (setf (getf plist :email) "ada@example.com")
  (incf (getf plist :age))
  (format t "~s~%" plist)
  (remf plist :name)
  (format t "~s~%" plist)
  (multiple-value-bind (indicator value tail)
      (get-properties plist '(:email :age))
    (format t "~a ~a ~a~%" indicator value tail)))
