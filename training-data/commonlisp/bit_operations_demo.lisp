(format t "~b AND ~b = ~b~%" 12 10 (logand 12 10))
(format t "~b OR  ~b = ~b~%" 12 10 (logior 12 10))
(format t "~b XOR ~b = ~b~%" 12 10 (logxor 12 10))
(format t "NOT 5 = ~d~%" (lognot 5))
(format t "1 << 10 = ~d~%" (ash 1 10))
(format t "1024 >> 3 = ~d~%" (ash 1024 -3))
(format t "popcount 255 = ~d~%" (logcount 255))
(format t "bit 3 of 8 set? ~a~%" (logbitp 3 8))
(format t "integer-length 255 = ~d~%" (integer-length 255))
(format t "bignum: ~d~%" (ash 1 100))
