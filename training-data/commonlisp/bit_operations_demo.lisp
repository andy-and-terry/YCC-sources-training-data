(format t "AND: ~b~%" (logand #b1100 #b1010))
(format t "OR:  ~b~%" (logior #b1100 #b1010))
(format t "XOR: ~b~%" (logxor #b1100 #b1010))
(format t "NOT: ~d~%" (lognot 5))
(format t "shl: ~d~%" (ash 3 4))
(format t "shr: ~d~%" (ash 48 -4))
(format t "popcount(255): ~d~%" (logcount 255))
(format t "bit 3 of 8 set: ~a~%" (logbitp 3 8))
(format t "integer-length(1000): ~d~%" (integer-length 1000))
(format t "byte field: ~d~%" (ldb (byte 4 4) #xAB))
