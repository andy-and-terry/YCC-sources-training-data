(defpackage :demo (:use :cl) (:export #:greet))
(in-package :demo)
(defun greet (n) (format nil "hi ~a" n))
(in-package :cl-user)
(format t "~a~%" (demo:greet "bob"))
(format t "~a ~a~%" (symbol-name 'foo) (symbol-package 'foo))
(format t "~a ~a~%" (intern "BAR") (find-symbol "BAR"))
(format t "~a ~a~%" (eq 'a 'a) (eq :k :k))
(format t "~a~%" (let ((s (gensym "G"))) (symbolp s)))
(format t "~a ~a~%" (get-universal-time) (stringp (lisp-implementation-type)))
(setf (get 'x 'color) 'red)
(format t "~a ~a~%" (get 'x 'color) (symbol-plist 'x))
