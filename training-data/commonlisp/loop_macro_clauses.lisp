(format t "~a~%" (loop for i from 1 to 5 collect (* i i)))
(format t "~a~%" (loop for x in '(3 1 4 1 5) maximize x))
(format t "~a~%" (loop for x in '(1 2 3 4) sum x into total finally (return (* total 2))))
(format t "~a~%" (loop for i below 10 when (evenp i) collect i))
(format t "~a~%" (loop for (k . v) in '((a . 1) (b . 2)) collect (list v k)))
(format t "~a~%" (loop for c across "abc" for i from 0 collect (cons i c)))
(format t "~a~%" (loop with a = 0 with b = 1 repeat 10 collect a do (psetf a b b (+ a b))))
(format t "~a~%" (loop for i from 10 downto 1 by 3 collect i))
(format t "~a~%" (loop for x in '(1 2 3) thereis (and (> x 1) x)))
