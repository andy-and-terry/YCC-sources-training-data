(defun topological-sort (num-nodes edges)
  (let ((adj (make-array num-nodes :initial-element nil))
        (visited (make-array num-nodes :initial-element nil))
        (result nil))
    (dolist (edge edges)
      (push (second edge) (aref adj (first edge))))
    (labels ((visit (node)
               (unless (aref visited node)
                 (setf (aref visited node) t)
                 (dolist (neighbor (aref adj node))
                   (visit neighbor))
                 (push node result))))
      (dotimes (n num-nodes)
        (visit n)))
    result))

(let ((edges '((5 2) (5 0) (4 0) (4 1) (2 3) (3 1))))
  (format t "topological order: ~a~%" (topological-sort 6 edges)))
