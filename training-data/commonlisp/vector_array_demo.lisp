(let ((v (make-array 5 :initial-element 0))
      (grid (make-array '(2 3) :initial-contents '((1 2 3) (4 5 6))))
      (growable (make-array 0 :adjustable t :fill-pointer 0)))
  (dotimes (i 5)
    (setf (aref v i) (* i i)))
  (format t "vector: ~a~%" v)
  (format t "length: ~a~%" (length v))
  (format t "grid[1][2]: ~a~%" (aref grid 1 2))
  (format t "grid dimensions: ~a~%" (array-dimensions grid))
  (dolist (x '(a b c))
    (vector-push-extend x growable))
  (format t "growable: ~a (fill-pointer ~a)~%" growable (fill-pointer growable))
  (format t "popped: ~a~%" (vector-pop growable)))
