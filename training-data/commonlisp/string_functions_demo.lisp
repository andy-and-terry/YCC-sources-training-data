(let ((s "  Hello, Common Lisp!  "))
  (print (string-trim " " s))
  (print (string-left-trim " " s))
  (print (string-right-trim " !" s))
  (print (string-upcase s))
  (print (string-downcase (string-trim " " s)))
  (print (string-capitalize "the quick brown fox")))

(let ((text "the rain in spain"))
  (print (search "ain" text))
  (print (search "ain" text :from-end t))
  (print (position #\Space text))
  (print (count #\i text))
  (print (subseq text 4 8))
  (print (substitute #\_ #\Space text))
  (print (remove #\a text)))

(print (string= "abc" "abc"))
(print (string-equal "ABC" "abc"))
(print (string< "apple" "banana"))
(print (concatenate 'string "foo" "-" "bar"))
(print (char-upcase #\a))
(print (char-code #\A))
(print (code-char 97))
(print (parse-integer "  42  "))
(print (parse-integer "ff" :radix 16))
(print (parse-integer "12abc" :junk-allowed t))
(print (coerce "abc" 'list))
(print (reverse "stressed"))
(print (map 'string #'char-upcase "shout"))
