(let ((text "Hello, World 42!"))
  (format t "upper: ~a~%" (string-upcase text))
  (format t "alpha count: ~a~%" (count-if #'alpha-char-p text))
  (format t "digit count: ~a~%" (count-if #'digit-char-p text))
  (format t "uppercase letters: ~a~%" (remove-if-not #'upper-case-p text))
  (format t "char code of A: ~a~%" (char-code #\A))
  (format t "code 97 is: ~a~%" (code-char 97))
  (format t "digit value of 7: ~a~%" (digit-char-p #\7))
  (format t "char< a b: ~a~%" (char< #\a #\b))
  (format t "next letter after c: ~a~%" (code-char (1+ (char-code #\c)))))
