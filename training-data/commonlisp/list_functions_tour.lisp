(let ((l '(3 1 4 1 5 9 2 6)))
  (format t "~a~%" (sort (copy-list l) #'<))
  (format t "~a ~a ~a~%" (remove-duplicates l) (remove 1 l) (remove-if #'evenp l))
  (format t "~a ~a~%" (reduce #'+ l) (reduce #'max l))
  (format t "~a ~a ~a~%" (subseq l 2 5) (nth 3 l) (last l 2))
  (format t "~a ~a~%" (position 5 l) (find-if (lambda (x) (> x 4)) l))
  (format t "~a~%" (mapcar #'+ '(1 2 3) '(10 20 30)))
  (format t "~a ~a~%" (count 1 l) (length l))
  (format t "~a~%" (member 4 l))
  (format t "~a~%" (union '(1 2) '(2 3)))
  (format t "~a ~a~%" (intersection '(1 2 3) '(2 3 4)) (set-difference '(1 2 3) '(2)))
  (format t "~a~%" (append '(1) '(2) '(3 4)))
  (format t "~a~%" (mapcan (lambda (x) (list x x)) '(1 2)))
  (format t "~a~%" (every #'numberp l)))
