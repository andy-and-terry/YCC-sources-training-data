(defun z-array (s)
  (let* ((n (length s))
         (z (make-array n :initial-element 0))
         (left 0) (right 0))
    (loop for i from 1 below n do
      (when (< i right)
        (setf (aref z i) (min (- right i) (aref z (- i left)))))
      (loop while (and (< (+ i (aref z i)) n)
                        (char= (char s (aref z i)) (char s (+ i (aref z i)))))
            do (incf (aref z i)))
      (when (> (+ i (aref z i)) right)
        (setf left i)
        (setf right (+ i (aref z i)))))
    z))

(defun z-search (text pattern)
  (let* ((combined (concatenate 'string pattern "$" text))
         (z (z-array combined))
         (m (length pattern))
         (matches nil))
    (dotimes (i (length z))
      (when (= (aref z i) m)
        (push (- i m 1) matches)))
    (nreverse matches)))

(format t "~a~%" (z-search "abxabcabcaby" "abcaby"))
(format t "~a~%" (z-search "hello world" "xyz"))
