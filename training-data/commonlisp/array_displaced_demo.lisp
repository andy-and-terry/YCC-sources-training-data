(let* ((base (make-array 8 :initial-contents '(0 1 2 3 4 5 6 7)))
       (window (make-array 3 :displaced-to base :displaced-index-offset 2)))
  (format t "~a~%" window)
  (setf (aref base 3) 99)
  (format t "~a~%" window)
  (setf (aref window 0) -1)
  (format t "~a~%" base)
  (multiple-value-bind (target offset) (array-displacement window)
    (format t "offset ~a same=~a~%" offset (eq target base))))
