#lang racket
(define/contract (safe-div a b)
  (-> number? (and/c number? (not/c zero?)) number?)
  (/ a b))
(displayln (safe-div 10 2))
(with-handlers ([exn:fail:contract? (λ (e) (displayln "contract violated"))])
  (safe-div 1 0))
(define/contract (positive-list xs)
  (-> (listof positive?) (listof positive?))
  (map add1 xs))
(displayln (positive-list '(1 2)))
(with-handlers ([exn:fail:contract? (λ (e) (displayln "bad list"))])
  (positive-list '(1 -2)))
(displayln (contract-name (-> integer? string?)))
