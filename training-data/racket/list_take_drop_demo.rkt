#lang racket

(define lst '(a b c d e f g))

(displayln (take lst 3))
(displayln (drop lst 3))
(displayln (take-right lst 2))
(displayln (drop-right lst 2))
(displayln (takef '(1 3 5 6 7) odd?))
(displayln (dropf '(1 3 5 6 7) odd?))
(displayln (first lst))
(displayln (last lst))
(displayln (list-tail lst 5))
(displayln (list-ref lst 4))
(displayln (index-of lst 'd))
(displayln (append (take lst 2) '(X) (drop lst 2)))
(displayln (add-between '(1 2 3) '-))
(displayln (flatten '(1 (2 (3 4)) 5)))
(displayln (append* '((1) (2 3) ())))
(displayln (remove 'c lst))
(displayln (remove* '(a b) lst))
(displayln (count even? '(1 2 3 4)))
(displayln (build-list 5 (lambda (i) (* i i))))
(displayln (make-list 3 'x))
(displayln (list-set lst 1 'B))
(displayln (check-duplicates '(1 2 3 2 1)))
(displayln (group-by even? '(1 2 3 4 5)))
(displayln (cartesian-product '(1 2) '(a b)))
(displayln (combinations '(a b c) 2))
(displayln (length (permutations '(1 2 3 4))))
