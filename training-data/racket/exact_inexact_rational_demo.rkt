#lang racket

(displayln (+ 1/3 1/6))
(displayln (* 2/3 3/4))
(displayln (numerator 6/4))
(displayln (denominator 6/4))
(displayln (+ 0.1 0.2))
(displayln (+ 1/10 2/10))
(displayln (= (+ 1/10 2/10) 3/10))
(displayln (exact->inexact 22/7))
(displayln (rationalize 0.3333 1/100))
(displayln (exact? 1/2))
(displayln (inexact? 0.5))
(displayln (integer? 4.0))
(displayln (exact-integer? 4.0))
(displayln (rational? 1/2))
(displayln (real? +inf.0))
(displayln (nan? +nan.0))
(displayln (infinite? (/ 1.0 0)))
(displayln (with-handlers ([exn:fail:contract:divide-by-zero? (lambda (e) 'div0)]) (/ 1 0)))
(displayln (max 1 2.0))
(displayln (min 1/2 1/3))
(displayln (abs -7/2))
(displayln (exact-floor 3.7))
(displayln (sgn -5))
