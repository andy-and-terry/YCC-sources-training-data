#lang racket
(define h (hash 'a 1 'b 2))
(define h2 (hash-set h 'c 3))
(displayln (list (hash-ref h 'a) (hash-ref h 'z 'none) (hash-count h2) (hash-has-key? h 'b)))
(displayln (sort (hash-keys h2) symbol<?))
(displayln (hash-update h 'a add1))
(define m (make-hash))
(for ([w '("a" "b" "a" "c" "a")]) (hash-update! m w add1 0))
(displayln (sort (hash->list m) string<? #:key car))
(hash-remove! m "a")
(displayln (hash-count m))
(displayln (hash-map h (λ (k v) (cons k (* v 10)))))
(define memo (make-hash))
(define (fib n) (or (hash-ref memo n #f) (let ([v (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2))))]) (hash-set! memo n v) v)))
(displayln (fib 80))
