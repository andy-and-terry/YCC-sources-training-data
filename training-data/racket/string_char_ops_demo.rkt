#lang racket

(define s "Hello, Racket!")

(displayln (string-length s))
(displayln (string-upcase s))
(displayln (string-downcase s))
(displayln (substring s 7 13))
(displayln (string-ref s 1))
(displayln (string-append s " Yes"))
(displayln (string-join (list "a" "b" "c") ", "))
(displayln (string-split "one  two three"))
(displayln (string-split "a,b,,c" ","))
(displayln (string-trim "  padded  "))
(displayln (string-replace "foo bar foo" "foo" "baz"))
(displayln (string-contains? s "Rack"))
(displayln (string-prefix? s "Hello"))
(displayln (string-suffix? s "!"))

(displayln (list->string (reverse (string->list "stressed"))))
(displayln (map char->integer (string->list "AZ")))
(displayln (integer->char 955))
(displayln (char-upcase #\q))
(displayln (list (char-alphabetic? #\a) (char-numeric? #\7) (char-whitespace? #\space)))
(displayln (build-string 5 (lambda (i) (integer->char (+ 97 i)))))
(displayln (string<? "apple" "banana"))
(displayln (string=? "a" "a"))
(displayln (number->string 255 2))
(displayln (string->number "ff" 16))
(displayln (string->number "not a number"))
(displayln (~a "pad" #:min-width 8 #:align 'right #:pad-string "."))
