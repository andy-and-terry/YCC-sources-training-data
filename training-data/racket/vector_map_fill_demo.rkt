#lang racket

(define v (make-vector 5 0))
(for ([i (in-range 5)]) (vector-set! v i (* i i)))
(displayln v)
(displayln (vector-map add1 v))
(displayln (vector->list v))
(displayln (vector-length v))
(displayln (vector-ref v 3))
(vector-fill! v 7)
(displayln v)
(define w (build-vector 4 (lambda (i) (* 10 i))))
(displayln w)
(displayln (vector-copy w 1 3))
(displayln (vector-append w #(1 2)))
(displayln (vector-argmin (lambda (x) (abs (- x 15))) w))
(displayln (for/vector ([x (in-vector w)] #:when (> x 0)) (/ x 10)))
(displayln (vector-count even? #(1 2 3 4)))
(displayln (vector-member 20 w))
(vector-copy! v 0 #(1 2 3))
(displayln v)
