#lang racket

(displayln (number->string 255 16))
(displayln (number->string 255 2))
(displayln (string->number "ff" 16))
(displayln (string->number "abc"))
(displayln (string->number "3.14"))
(displayln (exact->inexact 1/3))
(displayln (inexact->exact 0.5))
(displayln (real->decimal-string 3.14159 2))
(displayln (round 2.5))
(displayln (round 3.5))
(displayln (floor -2.5))
(displayln (truncate -2.5))
(displayln (exact-round 2.6))
(displayln (/ 6 4))
(displayln (quotient 17 5))
(displayln (remainder -17 5))
(displayln (modulo -17 5))
(displayln (expt 2 100))
(displayln (exact->inexact (sqrt 2)))
(displayln (sqrt -4))
(displayln (number->string 1e21))
