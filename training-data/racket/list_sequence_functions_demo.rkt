#lang racket

(define xs '(5 3 8 1 9 2))

(displayln (sort xs <))
(displayln (take xs 3))
(displayln (drop xs 3))
(define-values (front back) (split-at xs 2))
(displayln (list front back))
(displayln (take-while (lambda (x) (> x 2)) xs))
(define-values (evens odds) (partition even? xs))
(displayln (list evens odds))
(displayln (argmin (lambda (x) (abs (- x 4))) xs))
(displayln (remove-duplicates '(1 2 1 3 2)))
(displayln (append-map (lambda (x) (list x x)) '(1 2 3)))
(displayln (filter-map (lambda (x) (and (odd? x) (* x x))) xs))
(displayln (index-of xs 8))
(displayln (list-set xs 0 100))
(displayln (range 0 10 3))
(displayln (build-list 5 (lambda (i) (* i i))))
(displayln (flatten '(1 (2 (3 4)) 5)))
(displayln (group-by even? xs))
(displayln (apply max xs))
(displayln (foldl cons '() '(1 2 3)))
(displayln (count even? xs))
