#lang racket
(define ch (make-channel))
(define t (thread (λ () (for ([i 3]) (channel-put ch (* i 10))) (channel-put ch 'done))))
(displayln (let loop ([acc '()]) (let ([v (channel-get ch)]) (if (eq? v 'done) (reverse acc) (loop (cons v acc))))))
(define results (make-vector 4 #f))
(define ts (for/list ([i 4]) (thread (λ () (vector-set! results i (* i i))))))
(for-each thread-wait ts)
(displayln results)
(define sema (make-semaphore 0))
(thread (λ () (semaphore-post sema)))
(displayln (semaphore-wait sema))
(define mb (thread (λ () (displayln (thread-receive)))))
(thread-send mb "mailbox message")
(thread-wait mb)
(displayln (sync (handle-evt (alarm-evt (+ (current-inexact-milliseconds) 10)) (λ (_) 'timeout))))
