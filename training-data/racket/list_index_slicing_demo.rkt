#lang racket

(define xs '(a b c d e f))
(displayln (list-ref xs 2))
(displayln (take xs 2))
(displayln (drop xs 4))
(displayln (take-right xs 2))
(displayln (drop-right xs 2))
(displayln (list-tail xs 3))
(call-with-values (lambda () (split-at xs 2)) (lambda (a b) (displayln (list a b))))
(displayln (first xs))
(displayln (last xs))
(displayln (rest xs))
(displayln (second xs))
(displayln (list-set xs 1 'B))
(displayln (append (take xs 2) '(x) (drop xs 2)))
(displayln (range 3 8))
(displayln (range 0 10 3))
(displayln (build-list 4 (lambda (i) (* i i))))
(displayln (make-list 3 'z))
(displayln (takef '(2 4 5 6) even?))
(displayln (dropf '(2 4 5 6) even?))
