#lang racket
(define v (make-vector 5 0))
(for ([i 5]) (vector-set! v i (* i i)))
(displayln v)
(displayln (vector-map add1 v))
(displayln (vector->list (vector-take v 3)))
(displayln (vector-argmin identity v))
(define (make-matrix r c f) (for/vector ([i r]) (for/vector ([j c]) (f i j))))
(define m (make-matrix 2 3 (λ (i j) (+ (* i 3) j))))
(displayln m)
(define (mat-ref m i j) (vector-ref (vector-ref m i) j))
(displayln (mat-ref m 1 2))
(define (transpose m) (for/vector ([j (vector-length (vector-ref m 0))]) (for/vector ([i (vector-length m)]) (mat-ref m i j))))
(displayln (transpose m))
(vector-sort! v >)
(displayln v)
(displayln (vector-count even? v))
