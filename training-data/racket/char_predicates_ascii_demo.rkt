#lang racket

(define s "Hello, World 123!")
(displayln (filter char-alphabetic? (string->list s)))
(displayln (filter char-numeric? (string->list s)))
(displayln (length (filter char-whitespace? (string->list s))))
(displayln (filter char-punctuation? (string->list s)))
(displayln (map char-upcase (string->list "abc")))
(displayln (char->integer #\A))
(displayln (integer->char 955))
(displayln (char<? #\a #\b))
(displayln (char->integer #\newline))
(displayln (list->string (map char-downcase (string->list "ABC"))))
(displayln (char-general-category #\a))
(displayln (string #\a #\b))
(displayln (make-string 3 #\z))
(displayln (char-ci=? #\a #\A))
(displayln (map (lambda (c) (- (char->integer c) 48)) (string->list "2024")))
(displayln (char-blank? #\tab))
