#lang racket

(define names '(ann bob cy))
(define ages '(30 25 41))
(define zipped (map list names ages))
(displayln zipped)
(displayln (apply map list zipped))
(displayln (map cons names ages))
(define-values (ns as) (values (map car zipped) (map cadr zipped)))
(displayln ns)
(displayln as)
(displayln (for/list ([n names] [a ages] [i (in-naturals 1)]) (list i n a)))
(displayln (for/hash ([n names] [a ages]) (values n a)))
(displayln (map + '(1 2 3) '(10 20 30)))
(displayln (andmap < '(1 2 3) '(2 3 4)))
(displayln (ormap > '(1 2 3) '(5 5 1)))
(displayln (append-map (lambda (x) (list x x)) '(1 2)))
(displayln (filter-map (lambda (x) (and (even? x) (* x x))) '(1 2 3 4)))
(displayln (apply append '((1) (2 3) ())))
(displayln (add-between '(a b c) '-))
