#lang racket
(define compose2 (λ (f g) (λ (x) (f (g x)))))
(displayln ((compose2 add1 (curry * 2)) 5))
(displayln (map (curry + 10) '(1 2 3)))
(displayln (foldl cons '() '(1 2 3)))
(displayln (foldr cons '() '(1 2 3)))
(displayln (filter-map (λ (x) (and (odd? x) (* x x))) (range 10)))
(displayln (append-map (λ (x) (list x x)) '(1 2)))
(displayln (argmin abs '(-5 3 -1 4)))
(displayln (sort '("pear" "fig" "apple") < #:key string-length))
(displayln (remove-duplicates '(1 2 1 3 2)))
(displayln (group-by even? (range 6)))
(displayln (apply + 1 2 '(3 4)))
(displayln ((curryr list 'end) 'start))
(displayln (andmap positive? '(1 2)))
