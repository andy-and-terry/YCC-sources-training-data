#lang racket

(displayln (string=? "abc" "abc"))
(displayln (string<? "Apple" "apple"))
(displayln (string-ci<? "Apple" "banana"))
(displayln (string-ci=? "Hello" "hELLO"))
(displayln (equal? "a" "a"))
(displayln (eq? 'a 'a))
(displayln (eqv? 2.0 2.0))
(displayln (eqv? 2 2.0))
(displayln (= 2 2.0))
(displayln (equal? '(1 (2)) '(1 (2))))
(displayln (sort '("b" "B" "a" "A") string<?))
(displayln (sort '("b" "B" "a" "A") string-ci<?))
(displayln (string-foldcase "Straße"))
(displayln (string-upcase "straße"))
(displayln (string-length "héllo"))
(displayln (bytes-length (string->bytes/utf-8 "héllo")))
(displayln (string<=? "a" "a" "b"))
(displayln (char<? #\a #\B))
