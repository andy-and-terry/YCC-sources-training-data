(define (make-node k l r) (list k l r))
(define (key n) (car n)) (define (left n) (cadr n)) (define (right n) (caddr n))
(define (insert t k)
  (cond ((null? t) (make-node k '() '()))
        ((< k (key t)) (make-node (key t) (insert (left t) k) (right t)))
        ((> k (key t)) (make-node (key t) (left t) (insert (right t) k)))
        (else t)))
(define (inorder t) (if (null? t) '() (append (inorder (left t)) (list (key t)) (inorder (right t)))))
(define (height t) (if (null? t) 0 (+ 1 (max (height (left t)) (height (right t))))))
(define (member? t k) (cond ((null? t) #f) ((= k (key t)) #t) ((< k (key t)) (member? (left t) k)) (else (member? (right t) k))))
(define t (fold-left insert '() '(5 3 8 1 4 9)))
(display (inorder t)) (display (height t)) (display (member? t 4)) (display (member? t 7)) (newline)
