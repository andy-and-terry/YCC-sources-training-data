;; Z-algorithm: for each position i, Z[i] is the length of the longest
;; substring starting at i that matches a prefix of the string. Used here
;; for O(n+m) substring search by scanning Z over pattern+sep+text.

(define (z-array s)
  (define n (string-length s))
  (define z (make-vector n 0))
  (define l 0)
  (define r 0)
  (do ((i 1 (+ i 1)))
      ((= i n) z)
    (when (< i r)
      (vector-set! z i (min (- r i) (vector-ref z (- i l)))))
    (let extend ()
      (when (and (< (+ i (vector-ref z i)) n)
                 (char=? (string-ref s (vector-ref z i))
                         (string-ref s (+ i (vector-ref z i)))))
        (vector-set! z i (+ (vector-ref z i) 1))
        (extend)))
    (when (> (+ i (vector-ref z i)) r)
      (set! l i)
      (set! r (+ i (vector-ref z i))))))

(define (z-search text pattern)
  (define combined (string-append pattern "\x0;" text))
  (define plen (string-length pattern))
  (define z (z-array combined))
  (let loop ((i (+ plen 1)) (acc '()))
    (if (>= i (string-length combined))
        (reverse acc)
        (loop (+ i 1)
              (if (= (vector-ref z i) plen)
                  (cons (- i plen 1) acc)
                  acc)))))

(display (z-search "abxabcabcaby" "abc"))
(newline)
(display (z-search "aaaaa" "aa"))
(newline)
(display (z-search "hello world" "xyz"))
(newline)
