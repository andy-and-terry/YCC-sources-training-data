(define (prime? n)
  (and (> n 1)
       (let loop ((i 2))
         (cond ((> (* i i) n) #t)
               ((= 0 (modulo n i)) #f)
               (else (loop (+ i 1)))))))

(let loop ((y 1) (found 0))
  (if (< found 8)
      (let ((p (+ (* 3 y y) (* 3 y) 1)))
        (if (prime? p)
            (begin (display p) (display " ") (loop (+ y 1) (+ found 1)))
            (loop (+ y 1) found)))))
(newline)
