(define (expand-around s left right)
  (let loop ((l left) (r right))
    (if (and (>= l 0)
             (< r (string-length s))
             (char=? (string-ref s l) (string-ref s r)))
        (loop (- l 1) (+ r 1))
        (cons (+ l 1) (- r 1)))))

(define (longest-palindrome s)
  (let loop ((i 0) (best-start 0) (best-end 0))
    (if (>= i (string-length s))
        (substring s best-start (+ best-end 1))
        (let* ((odd (expand-around s i i))
               (even (expand-around s i (+ i 1)))
               (best-len (- best-end best-start))
               (odd-len (- (cdr odd) (car odd)))
               (even-len (- (cdr even) (car even))))
          (let* ((s1 (if (> odd-len best-len) odd (cons best-start best-end)))
                 (s2 (if (> even-len (- (cdr s1) (car s1))) even s1)))
            (loop (+ i 1) (car s2) (cdr s2)))))))

(display (longest-palindrome "babad"))
(newline)
(display (longest-palindrome "cbbd"))
(newline)
