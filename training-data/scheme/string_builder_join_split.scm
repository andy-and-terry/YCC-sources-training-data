(define (string-join lst sep)
  (if (null? lst) ""
      (fold-left (lambda (acc s) (string-append acc sep s)) (car lst) (cdr lst))))
(define (string-split s ch)
  (let loop ((chars (string->list s)) (cur '()) (out '()))
    (cond ((null? chars) (reverse (cons (list->string (reverse cur)) out)))
          ((char=? (car chars) ch) (loop (cdr chars) '() (cons (list->string (reverse cur)) out)))
          (else (loop (cdr chars) (cons (car chars) cur) out)))))
(display (string-join '("a" "b" "c") ", ")) (newline)
(write (string-split "x,y,,z" #\,)) (newline)
(define (string-repeat s n) (if (= n 0) "" (string-append s (string-repeat s (- n 1)))))
(display (string-repeat "ab" 3)) (newline)
(define (palindrome? s) (let ((l (filter char-alphabetic? (string->list (string-downcase s))))) (equal? l (reverse l))))
(display (palindrome? "A man, a plan, a canal: Panama")) (newline)
