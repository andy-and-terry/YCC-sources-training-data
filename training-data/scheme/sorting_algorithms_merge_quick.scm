(define (merge a b)
  (cond ((null? a) b) ((null? b) a)
        ((< (car a) (car b)) (cons (car a) (merge (cdr a) b)))
        (else (cons (car b) (merge a (cdr b))))))
(define (split l) (if (or (null? l) (null? (cdr l))) (values l '()) (let-values (((a b) (split (cddr l)))) (values (cons (car l) a) (cons (cadr l) b)))))
(define (msort l) (if (or (null? l) (null? (cdr l))) l (let-values (((a b) (split l))) (merge (msort a) (msort b)))))
(define (qsort l)
  (if (null? l) '()
      (let ((p (car l)) (r (cdr l)))
        (append (qsort (filter (lambda (x) (< x p)) r)) (list p) (qsort (filter (lambda (x) (>= x p)) r))))))
(display (msort '(5 2 9 1 5 6))) (newline)
(display (qsort '(3 1 4 1 5 9 2 6))) (newline)
(display (sort '(3 1 2) >)) (newline)
