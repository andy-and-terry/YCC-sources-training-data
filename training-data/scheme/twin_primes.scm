(define (prime? n)
  (and (> n 1)
       (let loop ((d 2))
         (cond ((> (* d d) n) #t)
               ((= 0 (modulo n d)) #f)
               (else (loop (+ d 1)))))))

(let loop ((p 3))
  (when (<= (+ p 2) 50)
    (when (and (prime? p) (prime? (+ p 2)))
      (display (list p (+ p 2)))
      (display " "))
    (loop (+ p 1))))
(newline)
