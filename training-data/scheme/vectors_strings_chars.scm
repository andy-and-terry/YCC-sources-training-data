(define v (make-vector 5 0))
(do ((i 0 (+ i 1))) ((= i 5)) (vector-set! v i (* i i)))
(display v) (newline)
(display (vector->list v)) (display (vector-length v)) (newline)
(display (vector-map (lambda (x) (+ x 1)) v)) (newline)
(vector-fill! v 7)
(display v) (newline)
(define s "Hello")
(display (string-length s)) (display (string-append s " World")) (display (substring s 1 3)) (newline)
(display (string-upcase s)) (display (string->list "abc")) (display (list->string (list #\x #\y))) (newline)
(display (char->integer #\A)) (display (char-upcase #\a)) (display (string->number "42")) (display (number->string 255 16)) (newline)
(display (string<? "apple" "banana")) (display (string=? "a" "a")) (newline)
