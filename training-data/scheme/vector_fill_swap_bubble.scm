(define v (vector 5 2 9 1))
(define (swap! v i j)
  (let ((t (vector-ref v i))) (vector-set! v i (vector-ref v j)) (vector-set! v j t)))
(let outer ((n (vector-length v)))
  (when (> n 1)
    (do ((i 0 (+ i 1))) ((>= i (- n 1)))
      (when (> (vector-ref v i) (vector-ref v (+ i 1))) (swap! v i (+ i 1))))
    (outer (- n 1))))
(display v) (newline)
