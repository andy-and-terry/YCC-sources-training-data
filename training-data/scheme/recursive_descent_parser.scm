(define (parse-expr tokens)
  (let* ((result (parse-term tokens))
         (value (car result))
         (rest (cdr result)))
    (let loop ((value value) (rest rest))
      (if (and (pair? rest) (memq (car rest) '(+ -)))
          (let* ((op (car rest))
                 (next (parse-term (cdr rest)))
                 (rvalue (car next))
                 (rrest (cdr next)))
            (loop (if (eq? op '+) (+ value rvalue) (- value rvalue)) rrest))
          (cons value rest)))))

(define (parse-term tokens)
  (let* ((result (parse-factor tokens))
         (value (car result))
         (rest (cdr result)))
    (let loop ((value value) (rest rest))
      (if (and (pair? rest) (memq (car rest) '(* /)))
          (let* ((op (car rest))
                 (next (parse-factor (cdr rest)))
                 (rvalue (car next))
                 (rrest (cdr next)))
            (loop (if (eq? op '*) (* value rvalue) (/ value rvalue)) rrest))
          (cons value rest)))))

(define (parse-factor tokens)
  (cons (car tokens) (cdr tokens)))

(define (evaluate tokens) (car (parse-expr tokens)))

(display (evaluate '(2 + 3 * 4)))
(newline)
(display (evaluate '(10 - 2 - 3)))
