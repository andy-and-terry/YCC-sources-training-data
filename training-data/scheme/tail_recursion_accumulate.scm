(define (fact n) (let loop ((n n) (acc 1)) (if (= n 0) acc (loop (- n 1) (* acc n)))))
(define (fib n) (let loop ((a 0) (b 1) (i n)) (if (= i 0) a (loop b (+ a b) (- i 1)))))
(define (length* l) (let loop ((l l) (n 0)) (if (null? l) n (loop (cdr l) (+ n 1)))))
(define (reverse* l) (let loop ((l l) (acc '())) (if (null? l) acc (loop (cdr l) (cons (car l) acc)))))
(display (fact 30)) (newline)
(display (fib 80)) (newline)
(display (length* '(a b c d))) (newline)
(display (reverse* '(1 2 3))) (newline)
(define (count-up n) (let loop ((i 0)) (if (< i n) (loop (+ i 1)) i)))
(display (count-up 1000000)) (newline)
