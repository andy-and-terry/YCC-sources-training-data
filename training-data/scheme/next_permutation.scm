(define (swap! vec i j)
  (let ((tmp (vector-ref vec i)))
    (vector-set! vec i (vector-ref vec j))
    (vector-set! vec j tmp)))

(define (next-permutation! vec)
  (let ((n (vector-length vec)))
    (let find-i ((i (- n 2)))
      (if (and (>= i 0) (>= (vector-ref vec i) (vector-ref vec (+ i 1))))
          (find-i (- i 1))
          (begin
            (if (>= i 0)
                (let find-j ((j (- n 1)))
                  (if (<= (vector-ref vec j) (vector-ref vec i))
                      (find-j (- j 1))
                      (swap! vec i j))))
            (let reverse-tail ((lo (+ i 1)) (hi (- n 1)))
              (if (< lo hi)
                  (begin (swap! vec lo hi) (reverse-tail (+ lo 1) (- hi 1))))))))
    vec))

(display (next-permutation! (vector 1 2 3)))
(newline)
(display (next-permutation! (vector 3 2 1)))
(newline)
(display (next-permutation! (vector 1 1 5)))
(newline)
