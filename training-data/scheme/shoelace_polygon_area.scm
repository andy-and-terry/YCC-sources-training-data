(define (area pts)
  (let loop ((ps pts) (s 0))
    (if (null? ps)
        (/ (abs s) 2)
        (let* ((p (car ps))
               (q (if (null? (cdr ps)) (car pts) (cadr ps))))
          (loop (cdr ps) (+ s (- (* (car p) (cadr q)) (* (car q) (cadr p)))))))))

(display (area '((0 0) (4 0) (4 3) (0 3))))
(newline)
