;; Objects as closures with message-passing dispatch.

(define (make-account balance)
  (define history '())
  (define (record! kind amount)
    (set! history (cons (list kind amount) history)))
  (define (deposit! amount)
    (set! balance (+ balance amount))
    (record! 'deposit amount)
    balance)
  (define (withdraw! amount)
    (if (> amount balance)
        'insufficient-funds
        (begin (set! balance (- balance amount))
               (record! 'withdraw amount)
               balance)))
  (define (dispatch msg . args)
    (cond ((eq? msg 'deposit) (apply deposit! args))
          ((eq? msg 'withdraw) (apply withdraw! args))
          ((eq? msg 'balance) balance)
          ((eq? msg 'history) (reverse history))
          (else (error "Unknown message" msg))))
  dispatch)

(define acc (make-account 100))
(display (acc 'deposit 50)) (newline)
(display (acc 'withdraw 30)) (newline)
(display (acc 'withdraw 500)) (newline)
(display (acc 'balance)) (newline)
(display (acc 'history)) (newline)

(define other (make-account 5))
(display (other 'balance)) (newline)
(display (acc 'balance)) (newline)
