(define (make-segment-tree values)
  (let* ((n (vector-length values))
         (tree (make-vector (* 4 n) 0)))
    (define (build node lo hi)
      (if (= lo hi)
          (vector-set! tree node (vector-ref values lo))
          (let ((mid (quotient (+ lo hi) 2))
                (left (* 2 node))
                (right (+ (* 2 node) 1)))
            (build left lo mid)
            (build right (+ mid 1) hi)
            (vector-set! tree node (+ (vector-ref tree left) (vector-ref tree right))))))
    (if (> n 0) (build 1 0 (- n 1)))
    (list tree n)))

(define (segment-tree-query st ql qr)
  (let ((tree (car st)) (n (cadr st)))
    (define (query node lo hi)
      (cond
        ((or (> ql hi) (< qr lo)) 0)
        ((and (<= ql lo) (>= qr hi)) (vector-ref tree node))
        (else
         (let ((mid (quotient (+ lo hi) 2)))
           (+ (query (* 2 node) lo mid)
              (query (+ (* 2 node) 1) (+ mid 1) hi))))))
    (query 1 0 (- n 1))))

(define (segment-tree-update! st idx value)
  (let ((tree (car st)) (n (cadr st)))
    (define (update node lo hi)
      (if (= lo hi)
          (vector-set! tree node value)
          (let ((mid (quotient (+ lo hi) 2))
                (left (* 2 node))
                (right (+ (* 2 node) 1)))
            (if (<= idx mid) (update left lo mid) (update right (+ mid 1) hi))
            (vector-set! tree node (+ (vector-ref tree left) (vector-ref tree right))))))
    (update 1 0 (- n 1))))

(define arr #(1 3 5 7 9 11))
(define st (make-segment-tree arr))

(display (segment-tree-query st 1 3))
(newline)
(display (segment-tree-query st 0 5))
(newline)

(segment-tree-update! st 1 10)
(display (segment-tree-query st 1 3))
(newline)
