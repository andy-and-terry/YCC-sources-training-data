;; Building number sequences with a hand-written iota and range helpers.

(define (range start end . step-opt)
  (let ((step (if (null? step-opt) 1 (car step-opt))))
    (let loop ((i start) (acc '()))
      (if (if (> step 0) (>= i end) (<= i end))
          (reverse acc)
          (loop (+ i step) (cons i acc))))))

(define (iota-from count start)
  (let loop ((i (- count 1)) (acc '()))
    (if (< i 0) acc (loop (- i 1) (cons (+ start i) acc)))))

(display (range 0 5))
(newline)
(display (range 10 0 -3))
(newline)
(display (range 0 1 1/4))
(newline)
(display (iota-from 5 100))
(newline)
(display (map (lambda (n) (* n n)) (range 1 8)))
(newline)
(display (apply + (range 1 101)))
(newline)
(display (map (lambda (i) (* 2 i)) (iota-from 4 0)))
(newline)
(display (range 5 5))
(newline)
