;; Exact versus inexact numbers and the numeric tower.

(display (/ 1 3))
(newline)
(display (exact->inexact (/ 1 3)))
(newline)
(display (+ 1/2 1/3))
(newline)
(display (* 1.0 (/ 6 4)))
(newline)
(display (exact? 3/4))
(display " ")
(display (inexact? 0.75))
(newline)
(display (integer? 4.0))
(display " ")
(display (rational? 1/2))
(display " ")
(display (real? 3))
(newline)
(display (quotient 17 5))
(display " ")
(display (remainder -17 5))
(display " ")
(display (modulo -17 5))
(newline)
(display (round 2.5))
(display " ")
(display (round 3.5))
(display " ")
(display (floor -2.5))
(display " ")
(display (ceiling 2.1))
(display " ")
(display (truncate -2.9))
(newline)
(display (numerator 6/4))
(display " ")
(display (denominator 6/4))
(newline)
(display (expt 2 100))
(newline)
(display (exact (floor 7.9)))
(newline)
(display (sqrt 16))
(display " ")
(display (sqrt 2))
(newline)
(display (number->string 255 16))
(display " ")
(display (string->number "1010" 2))
(newline)
