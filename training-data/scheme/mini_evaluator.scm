;; A tiny evaluator for arithmetic expressions with let-bindings.
;; Environments are association lists.

(define (lookup name env)
  (let ((b (assq name env)))
    (if b (cdr b) (error "Unbound variable" name))))

(define (evaluate expr env)
  (cond ((number? expr) expr)
        ((symbol? expr) (lookup expr env))
        ((pair? expr)
         (case (car expr)
           ((+) (+ (evaluate (cadr expr) env) (evaluate (caddr expr) env)))
           ((-) (- (evaluate (cadr expr) env) (evaluate (caddr expr) env)))
           ((*) (* (evaluate (cadr expr) env) (evaluate (caddr expr) env)))
           ((/) (/ (evaluate (cadr expr) env) (evaluate (caddr expr) env)))
           ((let)
            (let* ((binding (car (cadr expr)))
                   (value (evaluate (cadr binding) env)))
              (evaluate (caddr expr) (cons (cons (car binding) value) env))))
           ((if)
            (if (not (= 0 (evaluate (cadr expr) env)))
                (evaluate (caddr expr) env)
                (evaluate (cadddr expr) env)))
           (else (error "Unknown operator" (car expr)))))
        (else (error "Bad expression" expr))))

(define (show x) (display x) (newline))
(show (evaluate '(+ 1 (* 2 3)) '()))
(show (evaluate '(let ((x 5)) (* x x)) '()))
(show (evaluate '(let ((x 2)) (let ((y 3)) (+ x y))) '()))
(show (evaluate '(if (- 3 3) 10 20) '()))
(show (evaluate '(/ 1 4) '()))
(show (evaluate 'z '((z . 42))))
