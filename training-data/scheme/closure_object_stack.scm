;; A stack object implemented as a closure that dispatches on messages.

(define (make-stack)
  (let ((items '()))
    (define (push! x) (set! items (cons x items)))
    (define (pop!)
      (if (null? items)
          (error "stack underflow")
          (let ((top (car items)))
            (set! items (cdr items))
            top)))
    (define (dispatch msg . args)
      (cond ((eq? msg 'push) (apply push! args))
            ((eq? msg 'pop) (pop!))
            ((eq? msg 'peek) (car items))
            ((eq? msg 'size) (length items))
            ((eq? msg 'empty?) (null? items))
            (else (error "unknown message" msg))))
    dispatch))

(define s (make-stack))
(s 'push 1)
(s 'push 2)
(s 'push 3)
(display (s 'size)) (newline)
(display (s 'pop)) (newline)
(display (s 'peek)) (newline)
(display (s 'empty?)) (newline)
