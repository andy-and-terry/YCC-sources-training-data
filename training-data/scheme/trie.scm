(define (make-trie-node) (list '() #f))

(define (trie-children node) (car node))
(define (trie-end? node) (cadr node))

(define (trie-insert node word)
  (if (= (string-length word) 0)
      (list (trie-children node) #t)
      (let* ((c (string-ref word 0))
             (rest (substring word 1 (string-length word)))
             (children (trie-children node))
             (existing (assv c children))
             (child (if existing (cdr existing) (make-trie-node)))
             (new-child (trie-insert child rest))
             (new-children (cons (cons c new-child) (filter (lambda (e) (not (eqv? (car e) c))) children))))
        (list new-children (trie-end? node)))))

(define (trie-contains node word)
  (if (= (string-length word) 0)
      (trie-end? node)
      (let* ((c (string-ref word 0))
             (rest (substring word 1 (string-length word)))
             (existing (assv c (trie-children node))))
        (if existing (trie-contains (cdr existing) rest) #f))))

(define trie (trie-insert (trie-insert (make-trie-node) "cat") "car"))
(display (trie-contains trie "cat"))
(newline)
(display (trie-contains trie "ca"))
(newline)
