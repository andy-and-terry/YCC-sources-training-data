;; Searching lists: member, assoc, index lookup and find-first.

(define (index-of x lst)
  (let loop ((l lst) (i 0))
    (cond ((null? l) #f)
          ((equal? (car l) x) i)
          (else (loop (cdr l) (+ i 1))))))

(define (find-first pred lst)
  (cond ((null? lst) #f)
        ((pred (car lst)) (car lst))
        (else (find-first pred (cdr lst)))))

(define (find-index pred lst)
  (let loop ((l lst) (i 0))
    (cond ((null? l) #f)
          ((pred (car l)) i)
          (else (loop (cdr l) (+ i 1))))))

(define items '(apple banana cherry date))

(display (index-of 'cherry items))
(newline)
(display (index-of 'fig items))
(newline)
(display (find-first (lambda (x) (> x 10)) '(3 8 12 20)))
(newline)
(display (find-index even? '(1 3 5 6 7)))
(newline)
(display (member 'banana items))
(newline)
(display (memq 'zzz items))
(newline)
(display (list-ref items 2))
(newline)
(display (list-tail items 2))
(newline)
(display (length items))
(newline)
(display (assq 'b '((a 1) (b 2) (c 3))))
(newline)
