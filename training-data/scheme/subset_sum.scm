(define (subset-sum? values target)
  (define reachable (make-vector (+ target 1) #f))
  (vector-set! reachable 0 #t)
  (for-each
   (lambda (v)
     (let loop ((s target))
       (if (>= s v)
           (begin
             (if (vector-ref reachable (- s v))
                 (vector-set! reachable s #t))
             (loop (- s 1))))))
   values)
  (vector-ref reachable target))

(display (subset-sum? '(3 34 4 12 5 2) 9))
(newline)
(display (subset-sum? '(3 34 4 12 5 2) 10))
(newline)
(display (subset-sum? '(3 34 4 12 5 2) 13))
(newline)
(display (subset-sum? '() 0))
(newline)
