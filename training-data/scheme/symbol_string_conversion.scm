;; Converting between symbols, strings, characters and lists.

(display (symbol->string 'hello))
(newline)
(display (string->symbol "world"))
(newline)
(display (eq? 'abc (string->symbol "abc")))
(newline)
(display (symbol? 'x))
(display " ")
(display (symbol? "x"))
(newline)
(display (string->list "abc"))
(newline)
(display (list->string (list #\a #\b)))
(newline)
(display (string-append (symbol->string 'foo) "-" (symbol->string 'bar)))
(newline)
(write (string->symbol "Hello World"))
(newline)
(write 'MixedCase)
(newline)
(write (list 'a "b" #\c 1.5))
(newline)
(display (list 'a "b" #\c 1.5))
(newline)
(display (map symbol->string '(red green blue)))
(newline)
(display (string<? "apple" "banana"))
(newline)
(display (equal? (string->symbol "x") 'x))
(newline)
