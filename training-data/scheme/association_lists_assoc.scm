(define db '((alice . 30) (bob . 25) (carol . 41)))
(display (cdr (assq 'bob db))) (newline)
(display (assq 'zed db)) (newline)
(define (update-alist key val alist)
  (cond ((null? alist) (list (cons key val)))
        ((eq? (caar alist) key) (cons (cons key val) (cdr alist)))
        (else (cons (car alist) (update-alist key val (cdr alist))))))
(display (update-alist 'bob 26 db)) (newline)
(display (map car db)) (newline)
(display (assoc "b" '(("a" . 1) ("b" . 2)))) (newline)
(display (member 3 '(1 2 3 4))) (newline)
