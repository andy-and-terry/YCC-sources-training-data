       IDENTIFICATION DIVISION.
       PROGRAM-ID. DATEARITH.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 START-DATE  PIC 9(8) VALUE 20240228.
       01 END-DATE    PIC 9(8) VALUE 20241225.
       01 START-INT   PIC 9(7).
       01 END-INT     PIC 9(7).
       01 DAYS-BETWEEN PIC 9(5).
       01 NEW-INT     PIC 9(7).
       01 NEW-DATE    PIC 9(8).
       01 DATE-CHECK  PIC 9 VALUE 0.
       01 BAD-DATE    PIC 9(8) VALUE 20230230.

       PROCEDURE DIVISION.
           COMPUTE START-INT = FUNCTION INTEGER-OF-DATE(START-DATE)
           COMPUTE END-INT = FUNCTION INTEGER-OF-DATE(END-DATE)
           COMPUTE DAYS-BETWEEN = END-INT - START-INT
           DISPLAY "DAYS BETWEEN: " DAYS-BETWEEN

           COMPUTE NEW-INT = START-INT + 2
           COMPUTE NEW-DATE = FUNCTION DATE-OF-INTEGER(NEW-INT)
           DISPLAY "START + 2 DAYS: " NEW-DATE

           COMPUTE NEW-INT = START-INT + 90
           COMPUTE NEW-DATE = FUNCTION DATE-OF-INTEGER(NEW-INT)
           DISPLAY "START + 90 DAYS: " NEW-DATE

           COMPUTE DATE-CHECK = FUNCTION TEST-DATE-YYYYMMDD(BAD-DATE)
           IF DATE-CHECK = 0
               DISPLAY BAD-DATE " IS A VALID DATE"
           ELSE
               DISPLAY BAD-DATE " IS NOT A VALID DATE"
           END-IF
           STOP RUN.
