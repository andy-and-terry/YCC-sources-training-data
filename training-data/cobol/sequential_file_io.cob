       IDENTIFICATION DIVISION.
       PROGRAM-ID. SEQFILEIO.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT NAMES-FILE ASSIGN TO "names.dat"
               ORGANIZATION IS LINE SEQUENTIAL.
       DATA DIVISION.
       FILE SECTION.
       FD NAMES-FILE.
       01 NAME-RECORD PIC X(20).
       WORKING-STORAGE SECTION.
       01 END-OF-FILE PIC X VALUE "N".

       PROCEDURE DIVISION.
           OPEN OUTPUT NAMES-FILE
           MOVE "ALICE" TO NAME-RECORD
           WRITE NAME-RECORD
           MOVE "BOB" TO NAME-RECORD
           WRITE NAME-RECORD
           MOVE "CAROL" TO NAME-RECORD
           WRITE NAME-RECORD
           CLOSE NAMES-FILE

           OPEN INPUT NAMES-FILE
           PERFORM UNTIL END-OF-FILE = "Y"
               READ NAMES-FILE
                   AT END MOVE "Y" TO END-OF-FILE
                   NOT AT END DISPLAY "READ: " NAME-RECORD
               END-READ
           END-PERFORM
           CLOSE NAMES-FILE
           STOP RUN.
