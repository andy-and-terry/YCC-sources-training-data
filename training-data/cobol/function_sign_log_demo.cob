       IDENTIFICATION DIVISION.
       PROGRAM-ID. FUNCTIONSIGNLOG.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 NUM PIC S9(3) VALUE -42.
       01 SIGN-OUT PIC -9.
       01 LOG-OUT PIC -9.9999.
       01 LOG10-OUT PIC -9.9999.
       01 EXP-OUT PIC ZZ9.9999.

       PROCEDURE DIVISION.
           MOVE FUNCTION SIGN(NUM) TO SIGN-OUT
           DISPLAY "SIGN OF -42: " SIGN-OUT
           MOVE FUNCTION SIGN(0) TO SIGN-OUT
           DISPLAY "SIGN OF 0: " SIGN-OUT
           MOVE FUNCTION LOG(10) TO LOG-OUT
           DISPLAY "LN 10: " LOG-OUT
           MOVE FUNCTION LOG10(1000) TO LOG10-OUT
           DISPLAY "LOG10 1000: " LOG10-OUT
           MOVE FUNCTION EXP(2) TO EXP-OUT
           DISPLAY "EXP 2: " EXP-OUT
           STOP RUN.
