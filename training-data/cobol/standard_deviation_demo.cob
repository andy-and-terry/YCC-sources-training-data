       IDENTIFICATION DIVISION.
       PROGRAM-ID. STDDEVDEMO.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 ARR.
           05 ARR-ITEM PIC 9(3) OCCURS 5 TIMES.
       01 ITEM-COUNT PIC 9(1) VALUE 5.
       01 I PIC 9(2).
       01 SUM-VAL PIC 9(5) VALUE 0.
       01 MEAN-VAL PIC 9(3)V99.
       01 DIFF-VAL PIC S9(3)V99.
       01 SQUARED-DIFF PIC 9(5)V99.
       01 SUM-SQUARED-DIFF PIC 9(6)V99 VALUE 0.
       01 VARIANCE-VAL PIC 9(4)V9999.
       01 STD-DEV PIC 9(3)V9999.

       PROCEDURE DIVISION.
           MOVE 10 TO ARR-ITEM(1)
           MOVE 12 TO ARR-ITEM(2)
           MOVE 23 TO ARR-ITEM(3)
           MOVE 23 TO ARR-ITEM(4)
           MOVE 16 TO ARR-ITEM(5)

           PERFORM VARYING I FROM 1 BY 1 UNTIL I > ITEM-COUNT
               ADD ARR-ITEM(I) TO SUM-VAL
           END-PERFORM
           COMPUTE MEAN-VAL = SUM-VAL / ITEM-COUNT

           PERFORM VARYING I FROM 1 BY 1 UNTIL I > ITEM-COUNT
               COMPUTE DIFF-VAL = ARR-ITEM(I) - MEAN-VAL
               COMPUTE SQUARED-DIFF = DIFF-VAL * DIFF-VAL
               ADD SQUARED-DIFF TO SUM-SQUARED-DIFF
           END-PERFORM
           COMPUTE VARIANCE-VAL = SUM-SQUARED-DIFF / ITEM-COUNT
           COMPUTE STD-DEV = FUNCTION SQRT(VARIANCE-VAL)

           DISPLAY "MEAN: " MEAN-VAL
           DISPLAY "VARIANCE: " VARIANCE-VAL
           DISPLAY "STANDARD DEVIATION: " STD-DEV
           STOP RUN.
