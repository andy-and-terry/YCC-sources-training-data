public class MathRoundFloorCeil {
    public static void main() {
        Double d = 2.5;
        System.debug(Math.round(d));
        System.debug(Math.floor(-2.5));
        System.debug(Math.ceil(2.1));
        System.debug(Math.abs(-7));
        System.debug(Math.max(3, 9));
        System.debug(Math.pow(2, 10));
        System.debug(Math.mod(-7, 3));
    }
}
